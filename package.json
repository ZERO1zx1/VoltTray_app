{
  "name": "volttray",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first, read-only system tray battery monitor for Windows and Linux.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "bin": {
    "volttray-installer": "./scripts/cli.mjs"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "dev:server": "tsx src/server/main.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "install:cli": "node scripts/cli.mjs",
    "tauri:dev": "npx --yes @tauri-apps/cli@2 dev",
    "tauri:build": "npx --yes @tauri-apps/cli@2 build"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.5",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
